#!/usr/bin/env ruby
# frozen_string_literal: true

require 'schema-model'
require 'csv'
require 'json'
require 'optparse'

options = {
  json_file: nil,
  require_file: nil,
  csv_file: nil,
  schema_class_name: nil
}

OptionParser.new do |opts|
  opts.banner = "Usage: #{File.basename(__FILE__)} --require FILE --schema CLASS (--json FILE | -) [--csv FILE]"

  opts.on('--json JSON_FILE', 'JSON data') do |v|
    options[:json_file] = v
  end

  opts.on('-r', '--require FILE', 'File with schema model') do |v|
    options[:require_file] = v
  end

  opts.on('--csv CSV_FILE', 'File to output csv data (appended to if it exists)') do |v|
    options[:csv_file] = v
  end

  opts.on('--schema SCHEMA_CLASS_NAME', 'Name of the schema to apply to the json data') do |v|
    options[:schema_class_name] = v
  end
end.parse!

abort('no file required') unless options[:require_file]
abort('no schema specified') unless options[:schema_class_name]
abort("file #{options[:require_file]} not found") unless File.exist?(options[:require_file])

require File.expand_path(options[:require_file])

abort("schema #{options[:schema_class_name]} not found") unless Object.const_defined?(options[:schema_class_name])

schema_class = Object.const_get(options[:schema_class_name])
schema_class.schema_include Schema::Arrays

json_data =
  if options[:json_file]
    abort("json file #{options[:json_file]} not found") unless File.exist?(options[:json_file])
    File.read(options[:json_file])
  elsif ARGV.last == '-'
    $stdin.read
  else
    abort('no json data specified')
  end

# headers are written to stdout and to new files; an existing file is appended to as is
csv_file = options[:csv_file]
write_headers = csv_file.nil? || !File.exist?(csv_file)
io = csv_file ? File.open(csv_file, 'ab') : $stdout

io.print CSV.generate_line(schema_class.to_headers) if write_headers

begin
  json_data = JSON.parse(json_data)
rescue JSON::ParserError => e
  abort("invalid json: #{e.message.lines.first.strip}")
end
json_data = [json_data] unless json_data.is_a?(Array)

json_data.each do |data|
  io.print CSV.generate_line(schema_class.from_hash(data).to_a.flatten)
end

io.close if csv_file
